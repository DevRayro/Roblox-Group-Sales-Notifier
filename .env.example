# ────────────────────────────────────────────────────────────
#  Roblox Group Sales Notifier – Environment Variables
#  Copy this file to ".env" and fill in the values below.
# ────────────────────────────────────────────────────────────

# Your .ROBLOSECURITY cookie (required to read group transactions).
# How to get it:
#   1. Log into roblox.com on a private/incognito window.
#   2. Open DevTools (F12) → Application → Cookies → https://www.roblox.com
#   3. Copy the value of ".ROBLOSECURITY".
# ⚠️  NEVER share this cookie. It grants full access to your Roblox account.
ROBLOX_COOKIE=YOUR_ROBLOSECURITY_COOKIE_HERE

# Your Discord bot token (from https://discord.com/developers/applications).
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Discord application (client) ID — used to register slash commands.
DISCORD_CLIENT_ID=YOUR_DISCORD_APPLICATION_ID_HERE

# Optional: register slash commands to a single guild (instant) instead of globally (~1h).
# Leave empty to register globally.
DISCORD_GUILD_ID=

# The Roblox group ID you want to track.
GROUP_ID=0

# The Discord channel ID where sales notifications will be posted.
CHANNEL_ID=YOUR_DISCORD_CHANNEL_ID_HERE

# ────────── Optional tuning (sensible defaults are used) ──────────

# How often to poll the Roblox API for new sales (in seconds). Default: 60
POLL_INTERVAL_SECONDS=60

# Embed accent color in HEX (without #). Default: 00B0F4 (Discord blurple-ish)
EMBED_COLOR=00B0F4

# Set to "true" to also send a notification on bot startup with a recap.
SEND_STARTUP_RECAP=false
