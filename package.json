{
  "name": "roblox-group-sales-notifier",
  "version": "2.0.0",
  "description": "A modern Discord bot that notifies your server about Roblox group sales in real time, with stats, slash commands, and rich embeds.",
  "main": "src/index.js",
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "register": "node src/scripts/registerCommands.js"
  },
  "keywords": [
    "roblox",
    "discord",
    "bot",
    "sales",
    "notifier",
    "group",
    "webhook"
  ],
  "author": "DevRayro",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  }
}
